{
  "family": "hotel-pms",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/hotelPmsTaskRole",
  "containerDefinitions": [
    {
      "name": "hotel-pms",
      "image": "ACCOUNT_ID.dkr.ecr.REGION.amazonaws.com/hotel-pms:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "protocol": "tcp",
          "name": "http",
          "appProtocol": "http"
        }
      ],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "PORT", "value": "3000" },
        { "name": "HOSTNAME", "value": "0.0.0.0" },
        { "name": "APP_NAME", "value": "Hotel PMS" },
        { "name": "DEFAULT_TIMEZONE", "value": "Asia/Kolkata" },
        { "name": "MONGODB_DB_NAME", "value": "hotel-demo" },
        { "name": "APP_URL", "value": "https://nxt-tst.duckdns.org" },
        { "name": "BETTER_AUTH_URL", "value": "https://nxt-tst.duckdns.org" },
        { "name": "NEXT_PUBLIC_APP_URL", "value": "https://nxt-tst.duckdns.org" }
      ],
      "secrets": [
        {
          "name": "MONGODB_URI",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:hotel-pms/mongodb-uri"
        },
        {
          "name": "BETTER_AUTH_SECRET",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:hotel-pms/better-auth-secret"
        },
        {
          "name": "ENCRYPTION_KEY",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:hotel-pms/encryption-key"
        },
        {
          "name": "CRON_SECRET",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:hotel-pms/cron-secret"
        },
        {
          "name": "INTERNAL_WEBHOOK_SECRET",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:hotel-pms/internal-webhook-secret"
        }
      ],
      "environmentFiles": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/hotel-pms",
          "awslogs-region": "REGION",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "wget -qO- http://127.0.0.1:3000/api/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 40
      }
    }
  ]
}
